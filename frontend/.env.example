# Fill in after deploying (contracts/deployments.v4.<network>.json from scripts/deployV4.js), then restart `npm run dev`.
# --- V4 product stack (REQUIRED — release-check.cjs fails closed without every one of these) ---
VITE_FACTORY_V4_ADDRESS=0x0000000000000000000000000000000000000000   # LaunchFactoryV4 — every new launch; CREATE2 deployer for the …c0de grind
VITE_CURVE_V4_ADDRESS=0x0000000000000000000000000000000000000000     # CensusCurveV4 — curve trading until graduation
VITE_V4_ROUTER=0x0000000000000000000000000000000000000000            # CensusV4Router — post-graduation trades in the hooked pool
VITE_V4_HOOK=0x0000000000000000000000000000000000000000              # CensusV4Hook — charges the fee in the canonical pool (part of the PoolKey)
VITE_POOL_MANAGER=0x0000000000000000000000000000000000000000         # Uniswap V4 PoolManager
VITE_STATE_VIEW=0x0000000000000000000000000000000000000000           # Uniswap V4 StateView — getSlot0(poolId) spot reads (V4 has no TWAP)
VITE_V4_QUOTER=0x0000000000000000000000000000000000000000            # Uniswap V4Quoter — impact-aware "you receive" + minimum-out for pool trades

# --- Legacy V3-era contracts (OPTIONAL — only so old testnet coins still show; leave unset on a fresh chain) ---
# VITE_FACTORY_ADDRESS=0xf4509155753697d667B5954Ed93A65CE509C10f6      # LaunchFactory (legacy Prima, testnet 2026-09-17)
# VITE_FACTORY_V2_ADDRESS=0x0B3cd6f5c203caF0F7415E2A65897542c22872d2   # LaunchFactoryV2 (legacy Maxima)
# VITE_LOCKER_ADDRESS=0x50D1793aC84090Ddd871d576eaf5ea7663cFD6A7       # LaunchLocker (legacy)
# VITE_CURVE_ADDRESS=0xedc8e7286dC3D7C785dCED080d8366ABDbA65e40        # CensusCurve (legacy; graduated into V3 pools)
# VITE_QUOTER=0x...                                                    # Uniswap V3 QuoterV2 (legacy pool quotes only)

# Chain selection. Leave unset for Robinhood mainnet (4663). For any NON-mainnet build (e.g. testnet
# 46630) the Uniswap V3 addresses below are REQUIRED, not optional: off mainnet they no longer fall back to
# mainnet addresses (that silent bleed is fixed — CX-H3), so an unset VITE_WETH/VITE_SWAP_ROUTER becomes
# the zero address and trading fails loudly. Use the values from uniswap.robinhoodTestnet.json. WETH is
# what ETH-anchored coins wrap into for pool trades; the V3 factory prices the ETH/HOOD anchors via USDG.
# VITE_CHAIN_ID=46630
# VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
# VITE_WETH=0x823F4ef19CCE787C7D10483896eE0102F48A88eb          # WETH9 (testnet)
# VITE_SWAP_ROUTER=0x0F134877161c8C3Ab9A87e9B4c0e0280BF0D1D82   # SwapRouter02 (testnet; legacy V3 pools)
# VITE_V3_FACTORY=0x1e572f531c74f16B760e308DA684895B94A9D8E1    # required for anchor (ETH/HOOD) USD pricing off mainnet

# --- Board data source / scan cost (CX-S2) ---
# Without an indexer the board scans LaunchedV4 (and legacy) factory logs from VITE_FROM_BLOCK. Leave it 0
# for a fresh chain, but on mainnet set it to the factory DEPLOY block so the scan doesn't walk all of chain history.
# VITE_FROM_BLOCK=0
#
# Mainnet REHEARSAL builds only (side Vercel project on a throwaway stack — see MAINNET_RUNBOOK_V4.md,
# "Mainnet rehearsal"): adds a tiny "Rehearsal" graduation target and a red banner, and tells search
# engines not to index the page. NEVER set on the production project.
# VITE_REHEARSAL_GRADUATION_ETH=0.02
# The Census indexer is REQUIRED for a release (release-check.cjs): point the board at it (fast, scales).
# VITE_INDEXER_URL=https://indexer.census.example

# --- 0x (api/zeroex.ts serverless proxy). The V4 trade panel does NOT route through 0x: post-graduation
# trades go through CensusV4Router so the Census hook charges the fee. The proxy stays for tooling. ---
# The 0x API key is SERVER-SIDE ONLY. Set ZEROX_API_KEY (NO VITE_ prefix) in the Vercel project env so
# it never gets inlined into the browser bundle. Optional: ZEROX_API_BASE (defaults to https://api.0x.org).
# The client hits the proxy at /api/zeroex; override with VITE_ZEROX_PROXY only if you host it elsewhere.
# VITE_ZEROX_PROXY=/api/zeroex

# --- Privy: "Sign up" (email / Google / Apple / X + an embedded wallet on Robinhood Chain) next to "Connect wallet" ---
# Unset = wallet-only connect (the Privy SDK is never downloaded). App ID and Client ID are PUBLIC identifiers
# from the Privy dashboard. The Privy App Secret must NEVER go in a VITE_ variable (it would ship to browsers).
# VITE_PRIVY_APP_ID=cmtvxr5kv01g90cib2d6q5tjk   # the "Census Fund" Privy app (public ID; exactly 25 chars)
# VITE_PRIVY_CLIENT_ID=               # optional app client for this environment (e.g. one allowing localhost)
# VITE_PRIVY_LOGIN_METHODS=email     # must match the dashboard; add google,apple,twitter once those are switched on there
