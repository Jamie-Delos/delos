# ───────────────────────── secrets — NEVER commit real values ─────────────────────────
# Real config lives in .env files (gitignored); commit only the .env.example templates.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.keystore
.vercel

# ───────────────────────── dependencies / build output ─────────────────────────
node_modules
dist
build
cache
artifacts
typechain-types
coverage
coverage.json
*.tsbuildinfo
.test-build/
/contracts/pf-test-results.txt
/indexer/pf-pg-results.txt

# Deployment/network outputs (env-specific; re-generated by the deploy scripts)
deployments.*.json
uniswap.*.json

# ───────────────────────── OS / editor cruft ─────────────────────────
.DS_Store
Thumbs.db
*.swp

# ───────────────────────── not source (kept on disk, out of the shared code repo) ─────────────────────────
# Archives, generated exports, screenshots, personal media
*.zip
/*.pdf
/Logo.jpg
/*.jpeg
/WhatsApp Image*
/Census-Screenshots/

# One-off scratch scripts (underscore-prefixed)
/contracts/_*.js

# Design scratch / source art dumped in the frontend root — the app only uses frontend/public/*
/frontend/*.png
/frontend/*.jpg
/frontend/*.jpeg
/frontend/*.svg
/frontend/Dall-e/

# Session notes
/SESSION-*.md

# Internal business / fee strategy / status (not for the shared code repo)
/CENSUS_FEE_MODEL.md
/Census-fee-benchmark.md
/Census-fee-figures.md
/CENSUS_ONE_PAGER.md
/Census-one-pager.md
/Census-status-update.md
/DESIGNER_HANDOFF.md
/census-fee-options.html
/census-fee-signoff.html
/census-onepager.html

# Designer / partner handoff packages (large; delivered separately, not code)
/Designer Handoff/
/FromDesigner/
/design-handover/
/Census-Inner-Pages-Handoff/
/Ghost-Integration/
/Sumo-Integration/

