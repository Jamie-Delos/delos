# Copy to .env and fill in. NEVER commit .env.
# Target chain: Robinhood Chain mainnet (chainId 4663). Deploy with --network robinhood.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Arc testnet (Circle L1, USDC gas). Deploy with --network arc; fund via faucet.circle.com.
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
# Base Sepolia only used for automated fork tests, not deployment.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0xyour_wallet_private_key_here
BASESCAN_API_KEY=

# Deployed addresses (filled in by scripts/deploy.js output)
FACTORY_ADDRESS=
LOCKER_ADDRESS=
FEE_VAULT_ADDRESS=
