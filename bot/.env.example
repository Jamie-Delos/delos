# Copy to .env. NEVER commit .env.
# Everything runs in DRY_RUN mode unless you explicitly set DRY_RUN=false.
DRY_RUN=true

RPC_URL=https://rpc.mainnet.chain.robinhood.com
PRIVATE_KEY=0xyour_creator_wallet_private_key

# Deployed launchpad + Uniswap addresses (Robinhood Chain defaults baked into config.js)
LOCKER_ADDRESS=
SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# --- For Arc testnet instead, use: (UNITFLOW router is v1-style; swap calls need a deadline) ---
# RPC_URL=https://rpc.drpc.testnet.arc.network
# SWAP_ROUTER=0x509cF58CdA08C7aee83a2BdBb4A1Eac907343D01
# WETH=0x911b4000D3422F482F4062a913885f7b035382Df   # WUSDC (18-dec quote)

# The job: claim fees for this position, buy this reward token, airdrop to holders of the launch token.
TOKEN_ID=
LAUNCH_TOKEN=
REWARD_TOKEN=
FEE=3000

# Holder discovery: scan Transfer logs from this block (the launch token's deploy block is ideal).
FROM_BLOCK=0
BLOCK_CHUNK=10000

# Skip tiny holders (base units) to keep gas sane.
MIN_HOLDER_BALANCE=0

# --- buyback & burn (src/buyback.js) ---
# The FeeVault holding the protocol's 20% cut, and your ecosystem token to buy & burn.
FEE_VAULT_ADDRESS=
ECOSYSTEM_TOKEN=
# Only run once the vault holds at least this much WETH (base units). Default 0.1 WETH.
BUYBACK_MIN_WETH=100000000000000000

# --- 0x keeper (src/keeper0x.js): convert a v2 DividendVault's WETH fees into its stock basket ---
# Get a key at dashboard.0x.org. NEVER commit it (this file is .env.example; real values go in .env).
ZEROX_API_KEY=
ZEROX_API_BASE=https://api.0x.org
CHAIN_ID=4663
# Which swap engine: auto (try 0x, fall back to Uniswap if 0x can't quote a leg) | zerox | uniswap.
# Both paths live in the vault, so this flips at runtime with no redeploy. auto switches to 0x on its
# own once 0x enables the tokenised stocks.
MODE=auto
# The DividendVault to service (from the LaunchedV2 event / deploy output).
VAULT_ADDRESS=
# Uniswap V3 QuoterV2 — required for the Uniswap path's slippage protection (minOut). LIVE Uniswap
# runs are refused without it. Fill in once known for Robinhood Chain.
QUOTER_ADDRESS=
# Slippage floor (basis points) applied to both engines' minOut. 100 = 1%.
SLIPPAGE_BPS=100
# `node src/keeper0x.js probe` also reads PROBE_SELL (WETH base units, default 0.01 WETH).
