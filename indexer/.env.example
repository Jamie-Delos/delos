# Census indexer config. Copy to .env and fill in. Nothing here is secret except DATABASE_URL creds.

# Postgres (Prisma). On the company Prisma/Postgres, paste its connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/census?schema=public"

# Chain
RPC_URL="https://rpc.testnet.chain.robinhood.com"
CHAIN_ID=46630

# Deployed contracts (testnet defaults — override for mainnet). From contracts/deployments.<net>.json.
# Legacy V3 product (CensusCurve + locked Uniswap V3 pools). Set CURVE_ADDRESS to index it; when it is
# unset, the testnet default applies only to a V3-only deployment (with CURVE_V4_ADDRESS set and
# CURVE_ADDRESS unset or empty, only the V4 product is indexed).
CURVE_ADDRESS="0x76969310D2300e934c9ba731105a6420d920ee60"
FACTORY_ADDRESS="0xAfcDA11cdcB1EC228bAcB2d29Fc7eb0C45905358"
FACTORY_V2_ADDRESS="0x96420b4248c42ef19eb87D3254569Ea730cadF59"
WETH_ADDRESS="0x823F4ef19CCE787C7D10483896eE0102F48A88eb"

# V4 product (CensusCurveV4 + canonical Uniswap V4 pool with the Census hook; audit/V4-INTEGRATION-SPEC.md).
# From contracts/deployments.v4.<net>.json. Each is optional but must be a 0x address when set:
#   CURVE_V4_ADDRESS     indexes Registered/Traded/FeeAllocated/Graduated(poolId) of the V4 curve
#   POOL_MANAGER_ADDRESS indexes PoolManager Swap events of graduated V4 coins (filtered by poolId)
#   HOOK_ADDRESS         pairs each pool swap with the hook's FeeAccrued (fee split) and records
#                        FeesClaimed pushes to reward vaults ("collected" reward events)
#   FACTORY_V4_ADDRESS   recorded for operators; the indexer reads launches from the curve
# Changing the set of indexed curves changes the database identity: rebuild from a fresh database
# (events of the added curve before the old cursor would otherwise be missed).
# CURVE_V4_ADDRESS=
# FACTORY_V4_ADDRESS=
# POOL_MANAGER_ADDRESS=
# HOOK_ADDRESS=

# Backfill start block (the curve's deploy block; 0 is fine on testnet but slow on a busy chain).
START_BLOCK=0

# How often to poll for new blocks + reconcile live curve state (ms).
POLL_MS=4000

# Max blocks per getLogs page during backfill (lower if the RPC caps log ranges).
LOG_PAGE=5000

# API
PORT=8080
CORS_ORIGIN="*"
# Behind a load balancer / CDN, rate limiting must key on the real client IP. Set the number of
# trusted proxy hops (e.g. 1) or a comma-separated list of proxy IPs/CIDRs. A bare "true" is refused
# (anyone could then spoof X-Forwarded-For). Leave unset when clients connect directly.
# TRUST_PROXY=1

# USD pricing FAILS CLOSED: there is no default. Unset => priceUsd/marketCapUsd/volumeUsd are null for
# every coin quoted in that asset (the board must not show a placeholder). Set from a verified source
# and keep it current, or wire a feed before the board reads this indexer.
# ETH_USD=
# Other quote assets, e.g. HOOD: QUOTE_USD=0x32ac8c1d7672667d5ebdea22935f7b06fc8d496f=<usd>
# QUOTE_USD=
