// Census indexer schema. Postgres via Prisma. uint256 amounts are stored as decimal strings
// (they exceed int64); block numbers fit BigInt. Everything the board / coin pages / partners read
// is denormalised onto Coin so the hot queries are single-table and fast.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Coin {
  address         String   @id // token address, lowercased
  name            String   @default("")
  symbol          String   @default("")
  decimals        Int      @default(18)
  totalSupply     String   @default("0") // base units (string)
  creator         String   @default("")
  quote           String   @default("") // quote asset address (WETH / HOOD / a graduated company coin)
  quoteSymbol     String   @default("ETH")
  quoteDecimals   Int      @default(18) // the quote asset's own decimals (company-coin quotes may differ)
  quoteIsCoin     Boolean  @default(false) // meme pair: quoted in a Census company coin (UI highlights these)
  vault           String? // DividendVault (V3 Maxima) or CensusRewardVault (V4); null => no holder rewards
  holdersBps      Int      @default(0) // V3: holder share of the fee
  isV2            Boolean  @default(false) // has a reward vault
  product         String   @default("v3") // v3 (CensusCurve + locked V3 pool) | v4 (CensusCurveV4 + hooked V4 pool)
  reflectionBps   Int      @default(0) // V4: extra holder-reflection fee on top of the 2% base (0 or 100..400)

  // Live curve state (refreshed from the chain each reconcile).
  virtualQuote    String   @default("0")
  tokenReserve    String   @default("0")
  virtualTokenOffset String @default("0") // pricing-only, never minted; zero for legacy curves
  realQuote       String   @default("0")
  graduationQuote String   @default("0")
  graduated       Boolean  @default(false)
  pool            String? // graduated Uniswap V3 pool (V3 product; null for V4)
  poolId          String? // graduated canonical Uniswap V4 pool id, bytes32 (V4 product; null for V3)
  progressBps     Int      @default(0) // 0..10000 toward graduation

  // Aggregates for the board.
  priceQuote      Float    @default(0) // spot price, quote per token
  priceUsd        Float? // null = no configured USD price for the quote asset (fail closed)
  marketCapUsd    Float?
  volumeQuote     Float    @default(0) // cumulative quote volume
  volumeUsd       Float? // null once any trade could not be priced; rebuild after configuring a price
  tradeCount      Int      @default(0)
  holdersIndexed  Boolean  @default(false) // true only when Transfer history was indexed from mint

  createdBlock    BigInt   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades          Trade[]
  prices          PricePoint[]

  @@index([graduated])
  @@index([createdAt])
  @@index([marketCapUsd])
  @@index([updatedAt])
}

model HolderBalance {
  coinAddress String
  holder      String
  balance     Decimal @default(0) @db.Decimal(78, 0)

  @@id([coinAddress, holder])
  @@index([coinAddress, balance])
}

model Callout {
  id          String   @id @default(cuid())
  coinAddress String
  author      String
  text        String   @db.VarChar(1200)
  hidden      Boolean  @default(false) // operator can suppress abusive content in Postgres
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  likes       CalloutLike[]

  @@unique([coinAddress, author])
  @@index([coinAddress, updatedAt])
}

model CalloutLike {
  calloutId String
  wallet    String
  createdAt DateTime @default(now())
  callout   Callout @relation(fields: [calloutId], references: [id], onDelete: Cascade)

  @@id([calloutId, wallet])
}

model SocialNonce {
  nonce     String   @id
  wallet    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Trade {
  id          String   @id @default(cuid())
  coin        Coin     @relation(fields: [coinAddress], references: [address])
  coinAddress String
  trader      String
  isBuy       Boolean
  amountIn    String // buy: quote in (incl. fee); sell: tokens in
  amountOut   String // buy: tokens out; sell: quote out (net)
  fee         String // in quote (curve trades and V4 hooked-pool swaps; V3 pool swaps record "0" — LP fees accrue in the position)
  // V4 fee split of `fee` (FeeAllocated on the curve; FeeAccrued from the hook, where penalty is folded into
  // protocol/creator and stays "0"). All "0" on V3 trades.
  feeProtocol String   @default("0")
  feeCreator  String   @default("0")
  feeHolders  String   @default("0")
  feePenalty  String   @default("0")
  priceQuote  Float // quote per token at this trade
  venue       String   @default("curve") // curve | pool (the coin's own graduated pool)
  block       BigInt
  txHash      String
  logIndex    Int
  ts          DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([coinAddress, ts])
  @@index([ts])
}

// Holder-reward ledger: vault distributions, claims and launch-token fee conversions, indexed from
// finalized events so payouts are auditable next to trading volume.
model RewardEvent {
  id          String   @id @default(cuid())
  coinAddress String
  kind        String // distributed | claimed | converted | collected (V4: hook fees pushed to the vault)
  holder      String? // claimed: the holder paid
  asset       String? // claimed/collected: the payout asset; converted/distributed: the quote asset
  amount      String   @default("0") // distributed: quote spent; claimed/collected: amount paid; converted: launch tokens sold
  amountB     String   @default("0") // converted: quote received
  block       BigInt
  txHash      String
  logIndex    Int
  ts          DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([coinAddress, ts])
  @@index([holder])
}

model PricePoint {
  id          String   @id @default(cuid())
  coin        Coin     @relation(fields: [coinAddress], references: [address])
  coinAddress String
  priceQuote  Float
  priceUsd    Float?
  block       BigInt
  ts          DateTime @default(now())

  @@index([coinAddress, ts])
}

// Ingestion cursor so restarts resume instead of re-scanning from START_BLOCK.
model Cursor {
  id        String @id // e.g. "curve"
  lastBlock BigInt @default(0)
  lastHash  String?
  chainId   Int?
  curve     String?
}

model IndexedEvent {
  chainId   Int
  txHash    String
  logIndex  Int
  block     BigInt
  blockHash String

  @@id([chainId, txHash, logIndex])
  @@index([block])
}
