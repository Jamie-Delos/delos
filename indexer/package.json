{
  "name": "census-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Census chain indexer — ingests CensusCurve launches/trades/graduations into Postgres and serves a fast REST + WebSocket API for the app board, coin pages, and partners.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node backend.readiness.cjs",
    "test:pg": "node postgres.readiness.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^5.19.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.4",
    "viem": "^2.21.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.19.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}
